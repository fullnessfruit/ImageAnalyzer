{
  "name": "image-analyzer",
  "version": "2.0.0",
  "description": "Local API server: OCR list matching, real-person face recognition, anime character and costume recognition",
  "main": "server/dist/index.js",
  "scripts": {
    "build": "tsc -p server/tsconfig.json",
    "server": "npm run build && node server/dist/index.js",
    "server:ocr": "npm run build && node server/dist/index.js --ocr-only",
    "dev": "npx nodemon --watch server/src --ext ts --exec \"npm run build && node server/dist/index.js\"",
    "analyze": "npx ts-node scripts/analyze.ts",
    "register:all": "npx ts-node scripts/register.ts all",
    "register:faces": "npx ts-node scripts/register.ts face",
    "register:characters": "npx ts-node scripts/register.ts character",
    "register:costumes": "npx ts-node scripts/register.ts costume",
    "candidates": "npx ts-node scripts/candidates.ts",
    "search-strings": "npx ts-node scripts/search-strings.ts",
    "tags": "npx ts-node scripts/tags.ts",
    "detect": "npx ts-node scripts/detect.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "onnxruntime-node": "^1.19.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
